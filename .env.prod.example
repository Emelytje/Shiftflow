# ─────────────────────────────────────────────────────────────
# ShiftFlow — PRODUCTIE .env (voorbeeld)
# Kopieer naar .env op je server en vul in met STERKE waarden.
# Genereer secrets met:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# Jouw domein (DNS A-record moet naar de server-IP wijzen)
DOMAIN=shiftflow.jouwdomein.be

# Database
POSTGRES_USER=shiftflow
POSTGRES_PASSWORD=VERVANG_door_sterk_wachtwoord
POSTGRES_DB=shiftflow

# Secrets (elk minstens 32 tekens, uniek!)
JWT_ACCESS_SECRET=VERVANG_openssl_rand_hex_32
JWT_REFRESH_SECRET=VERVANG_openssl_rand_hex_32
ENCRYPTION_KEY=VERVANG_openssl_rand_hex_32
