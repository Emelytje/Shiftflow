# ─────────────────────────────────────────────────────────────
# ShiftFlow — Environment configuratie (voorbeeld)
# Kopieer naar .env en pas aan. Commit NOOIT je echte .env.
# ─────────────────────────────────────────────────────────────

# --- Algemeen ---
NODE_ENV=development

# --- API ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
POSTGRES_USER=shiftflow
POSTGRES_PASSWORD=shiftflow_dev_password
POSTGRES_DB=shiftflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shiftflow:shiftflow_dev_password@localhost:5432/shiftflow?schema=public

# --- Redis (cache, sessies, realtime pub/sub, queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# --- OAuth providers (optioneel, later in te vullen) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=shiftflow
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- AI ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- E-mail / notificaties (optioneel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@shiftflow.app
